import Mathlib.Topology.Basic
import Mathlib.Order.Lattice
import Mathlib.Tactic

set_option maxHeartbeats 1000000

namespace ConstructiveAnalysis

universe u

variable {T : Type u}

def left_ray [LE T] (a : T) : Set T := {x | x ≤ a}

lemma left_ray_inter [SemilatticeInf T] (a b : T) :
    left_ray a ∩ left_ray b = left_ray (a ⊓ b) := by
  ext x
  simp [left_ray, le_inf_iff]

/--
The topology generated by the left rays of `ℤ`.

The Lean 3 source attempted to characterize every open as `∅`, `Set.univ`, or a
single left ray. Proving that characterization for an arbitrary union would
require selecting a maximum from an arbitrary bounded family of integers.
`generateFrom` instead gives the standard topology generated by those rays
without introducing classical choice.
-/
@[reducible] def left_ray_topology : TopologicalSpace ℤ :=
  TopologicalSpace.generateFrom (Set.range (left_ray : ℤ → Set ℤ))

lemma isOpen_left_ray (z : ℤ) :
    @IsOpen ℤ left_ray_topology (left_ray z) :=
  TopologicalSpace.isOpen_generateFrom_of_mem ⟨z, rfl⟩

end ConstructiveAnalysis
